# DueLogic local development configuration.
# Copy to .env.local and fill in your own Pinch sandbox values.
# Never commit .env.local or any real credential.

# Pinch OAuth client credentials (sandbox application).
PINCH_APP_ID=
PINCH_APP_SECRET=

# Pinch sandbox API base URL from your Pinch developer settings.
PINCH_API_BASE_URL=

# Secret used to verify the pinch-signature header on incoming webhooks.
PINCH_WEBHOOK_SECRET=

# Server-side HMAC secret for the development OTP code digests.
# Any long random string; a missing value makes OTP verification fail closed.
DUELOGIC_OTP_HMAC_SECRET=
